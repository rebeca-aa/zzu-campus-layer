{
  "name": "zzu-campus-layer",
  "private": true,
  "version": "0.2.37",
  "type": "module",
  "description": "郑州大学「校园信息层」——基于实测 API 的 MV3 侧边栏助手",
  "scripts": {
    "build": "vite build",
    "watch": "vite build --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:live": "vitest run test/live.test.ts",
    "fixtures": "node scripts/capture.mjs",
    "e2e": "node scripts/e2e.mjs",
    "pwa:serve": "node scripts/serve-pwa.mjs",
    "pwa:shot": "node scripts/pwa-shot.mjs",
    "pwa:quick": "node scripts/pwa-quickask.mjs",
    "pwa:transcript": "node scripts/pwa-transcript.mjs",
    "verify": "node node_modules/typescript/lib/tsc.js --noEmit && node node_modules/vitest/vitest.mjs run && node node_modules/vite/bin/vite.js build"
  },
  "dependencies": {
    "preact": "^10.24.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.280",
    "@types/node": "^22.20.5",
    "typescript": "^5.6.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
